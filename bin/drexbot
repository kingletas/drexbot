#!/usr/bin/env bash
#
# Thin wrapper so the command is `drexbot` rather than a path into dist/.
# The CLI resolves the package root from this file's own location, so the link
# chain below has to be followed before that path means anything.
#
# Node bundles its own CA list and ignores the system trust store, so a target
# served over a locally-issued certificate fails verification here even though
# curl and every browser on this machine accept it. The mkcert, Warden and Den
# roots are added when they exist. Verification is never disabled -- a harness
# that skips TLS checks cannot make any statement about a target's TLS.
set -euo pipefail

# A symlink to this file is not where the code is, so follow the link chain to
# the real file before resolving dist/. Without this, anything reached through
# a symlink looks for main.js beside the link and fails with a module it cannot
# find.
source="${BASH_SOURCE[0]}"
while [[ -L "$source" ]]; do
	target=$(readlink "$source")
	if [[ $target == /* ]]; then
		source="$target"
	else
		source="$(cd "$(dirname "$source")" && pwd)/$target"
	fi
done

here=$(cd "$(dirname "$source")" && pwd)

roots=()

# Keeps a readable root unless the same certificate is already kept, as mkcert installs one copy per store.
add_root() {
	local kept
	[[ -r "$1" ]] || return 0
	if ((${#roots[@]} > 0)); then
		for kept in "${roots[@]}"; do
			if cmp -s "$kept" "$1"; then
				return 0
			fi
		done
	fi
	roots+=("$1")
}

# Prints every root with a newline after each, so a file missing its last one cannot merge two PEM blocks.
print_roots() {
	local ca
	for ca in "${roots[@]}"; do
		cat "$ca" || return 1
		echo
	done
}

# Joins the roots into one file and prints its path, in a directory only this user can write.
write_bundle() {
	local dir="${XDG_CACHE_HOME:-${HOME}/.cache}/drexbot" tmp
	mkdir -p "$dir" 2>/dev/null || return 1
	[[ -O "$dir" ]] || return 1
	chmod 700 "$dir" 2>/dev/null || return 1

	tmp=$(mktemp "${dir}/extra-ca.XXXXXX" 2>/dev/null) || return 1
	if ! print_roots >"$tmp" || ! mv -f "$tmp" "${dir}/extra-ca.pem"; then
		rm -f "$tmp"
		return 1
	fi
	printf '%s\n' "${dir}/extra-ca.pem"
}

if [[ -z "${NODE_EXTRA_CA_CERTS:-}" ]]; then
	if [[ -n "${CAROOT:-}" ]]; then
		add_root "${CAROOT}/rootCA.pem"
	fi
	add_root "${XDG_DATA_HOME:-${HOME}/.local/share}/mkcert/rootCA.pem"
	add_root "${HOME}/Library/Application Support/mkcert/rootCA.pem"
	for ca in /usr/local/share/ca-certificates/mkcert*.crt; do
		add_root "$ca"
	done
	add_root "${WARDEN_HOME_DIR:-${HOME}/.warden}/ssl/rootca/certs/ca.cert.pem"
	add_root "${DEN_HOME_DIR:-${HOME}/.den}/ssl/rootca/certs/ca.cert.pem"

	# Node reads one file, so several roots are joined; if that cannot be written, the first still helps.
	if ((${#roots[@]} == 1)); then
		export NODE_EXTRA_CA_CERTS="${roots[0]}"
	elif ((${#roots[@]} > 1)); then
		if bundle=$(write_bundle); then
			export NODE_EXTRA_CA_CERTS="$bundle"
		else
			export NODE_EXTRA_CA_CERTS="${roots[0]}"
		fi
	fi
fi

exec node "${here}/../dist/src/cli/main.js" "$@"
