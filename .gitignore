node_modules/
dist/

# Secrets — every .env variant is ignored except the checked-in template
.env
.env.*
!.env.example

# Run output. Per-run artefacts are not committed.
results/
/test-results/

# State signatures ARE committed: what a target refuses, what it does not
# support and what is quarantined are facts about the software, identical on
# every machine, and putting them under review means a check going permanently
# unsupported shows up as a diff somebody has to approve.
#
# Measurement baselines are NOT, and the difference is not tidiness. A timing
# is a fact about the machine that produced it, so a laptop's history judging
# a CI runner's numbers reports a regression that is only a change of hardware.
/baselines/*.measurements.json

# Nor is the notification state, for the same reason: it records who has been
# told what on this machine, and a committed copy would make one person's
# channel decide whether another person's run says anything.
/baselines/*.notify.json

# The user-level ~/.gitignore is core.excludesFile for every repository under
# $HOME and excludes these outright. Without the negations this repository
# silently loses its scripts and its node version pin.
!*.sh
!.nvmrc
!*.local

.DS_Store
*.swp

# Disposable output: build products, screenshots, working images, scratch
# notes. Nothing here is reviewed and nothing here is committed.
#
# It carries its own line because the machine this was written on hides it
# through a user-level excludes file, and a clone has none of that.
local.d/
