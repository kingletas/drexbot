# drexbot-shop.timer: starts drexbot-shop.service every five minutes.
#
# A template, and nothing installs it; drexbot-shop.service says how to.
#
# Edit before use: OnCalendar, only together with --per in shop.env, because a
# slice is as long as the interval between ticks. `*:0/5` is every five minutes
# on the clock, at :00, :05, :10 and so on.
#
# Persistent=false on purpose: a tick missed while the machine was off or busy
# is not caught up, so the store never gets a burst of back orders. If a run is
# still going when the next tick comes, systemd leaves it running and starts
# nothing, and that slice is lost.

[Unit]
Description=drexbot shop: a slice of customers every five minutes

[Timer]
OnCalendar=*:0/5
Persistent=false
AccuracySec=1s

[Install]
WantedBy=timers.target
